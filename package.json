{
  "name": "talino",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@bacons/apple-targets": "^5.0.0",
    "@expo-google-fonts/jetbrains-mono": "^0.4.1",
    "@expo-google-fonts/material-symbols-rounded": "^0.4.65",
    "@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
    "@expo/ui": "~58.0.28",
    "@expo/vector-icons": "^15.0.2",
    "@reduxjs/toolkit": "^2.14.0",
    "@sentry/react-native": "~8.28.0",
    "@tanstack/react-query": "^5.107.1",
    "acorn": "^8.19.0",
    "expo": "~58.0.25",
    "expo-asset": "~58.0.21",
    "expo-audio": "~58.0.12",
    "expo-blur": "~58.0.6",
    "expo-build-properties": "~58.0.12",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-device": "~58.0.5",
    "expo-document-picker": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "~58.0.8",
    "expo-image": "~58.0.18",
    "expo-image-manipulator": "~58.0.16",
    "expo-image-picker": "~58.0.10",
    "expo-linear-gradient": "~58.0.4",
    "expo-linking": "~58.0.17",
    "expo-localization": "~58.0.5",
    "expo-mail-composer": "~58.0.4",
    "expo-network": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-print": "~58.0.9",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-speech": "~58.0.4",
    "expo-splash-screen": "~58.0.14",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.0.8",
    "expo-widgets": "~58.0.29",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.14",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-purchases": "10.16.0",
    "react-native-purchases-ui": "10.16.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "react-redux": "^9.3.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@react-native/jest-preset": "^0.88.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "~19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo run:android",
    "android:prod": "expo run:android --variant release",
    "ios": "expo run:ios --device \"iPhone 18 Pro\"",
    "ios:prod": "expo run:ios --device \"iPhone 18 Pro\" --configuration Release",
    "ios:watch": "TALINO_WATCH=1 expo prebuild --platform ios --no-install && expo run:ios --device \"iPhone 18 Pro\"",
    "prebuild:ios": "expo prebuild --platform ios --clean",
    "prebuild:android": "expo prebuild --platform android --clean",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm test",
    "doctor": "npx expo-doctor",
    "release:android": "node scripts/release-android.mjs",
    "release:android:apk": "node scripts/release-android.mjs --apk",
    "release:ios": "node scripts/release-ios.mjs",
    "release:ios:watch": "TALINO_WATCH=1 node scripts/release-ios.mjs",
    "test:watch-swift": "diff targets/watch/StreakMath.swift targets/watch-widget/StreakMath.swift && swiftc -o \"${TMPDIR:-/tmp}/talino-streak-checks\" targets/watch/StreakMath.swift scripts/watch-checks/main.swift && \"${TMPDIR:-/tmp}/talino-streak-checks\"",
    "test": "jest --passWithNoTests",
    "i18n:queue": "WRITE_QUEUE=1 jest src/features/courses/lib/localization-queue.test.ts"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/jest/css-stub.js",
      "^@/assets/(.*)$": "<rootDir>/assets/$1"
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|native-base|react-native-svg|immer|@reduxjs/toolkit|reselect|redux|react-redux|standard-navigation)"
    ],
    "setupFiles": [
      "<rootDir>/jest/setup.js"
    ],
    "resolver": "react-native-worklets/jest/resolver.js",
    "watchman": false
  }
}
